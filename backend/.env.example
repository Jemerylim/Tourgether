# Copy to backend/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=5000

# MongoDB: local install, or mongodb://mongo:27017/Tourgether inside Docker
DATABASE_URL=mongodb://localhost:27017/Tourgether
JWT_SECRET=change-me-to-a-long-random-string

# Where the React app is served. Invite and password-reset emails link here.
CLIENT_URL=http://localhost:5173
# Comma-separated origins allowed to call the API (defaults to CLIENT_URL). Use * for any.
# CORS_ORIGINS=http://localhost:5173,https://tourgether.example

# Gmail account that sends invite and reset emails (use an app password)
EMAIL_USER=
EMAIL_PASS=

# Load the variables above from AWS Secrets Manager instead.
# Defaults to TourgetherSecrets when NODE_ENV=production; unset locally to skip AWS.
# AWS_SECRET_ID=TourgetherSecrets
# AWS_REGION=us-east-1
